import pandas as pd
df = pd.read_csv("raw_data.csv") 
# Check the data types of all columns in the original DataFrame
df.dtypes

# Create an independent copy so the original DataFrame remains unchanged
df2 = df.copy()

# Replace all missing (NaN) values with 0
df2 = df2.fillna(0)

# Convert the 'age' column to 64-bit integer type
df2["age"] = df2["age"].astype("int64").copy()

# Check the updated data types
df2.dtypes


# String operations in Pandas

# Capitalize the first character of each value in the gender column
df["gender"].str.capitalize()

# Split each name into a list of words wherever a space occurs
df["name"].str.split(" ")

# Check whether the country column contains "india"
# case=False makes the search case-insensitive (India, INDIA, india).
df["country"].str.contains("india", case=False)


df



